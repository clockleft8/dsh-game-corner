{
    "name":  "dsh-game-corner",
    "version":  "0.1.0",
    "description":  "DSH 小游戏角：五子棋/2048/扫雷/坦克/象棋/国象/围棋(19路)/公式本，含可拖动浮窗。",
    "license":  "MIT",
    "engines":  {
                    "node":  "\u003e=22",
                    "dsh":  "\u003e=0.2.0"
                },
    "type":  "module",
    "main":  "index.js",
    "exports":  {
                    ".":  "./index.js",
                    "./client":  "./client.js",
                    "./package.json":  "./package.json",
                    "./icon":  "./icon.svg"
                },
    "files":  [
                  "index.js",
                  "client.js",
                  "cordis.patch.yml",
                  "icon.svg",
                  "README.md",
                  "LICENSE"
              ],
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "immediately":  true,
                               "inject":  [
                                              "slots",
                                              "@deepseek-ai/dsh-client-ui-conversation"
                                          ],
                               "external":  [
                                                "react"
                                            ]
                           }
            },
    "keywords":  [
                     "deepseek-harness",
                     "dsh-plugin"
                 ],
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/clockleft8/dsh-game-corner.git"
                   },
    "homepage":  "https://github.com/clockleft8/dsh-game-corner#readme",
    "publishConfig":  {
                          "access":  "public"
                      }
}
